    "q2_evolucao_ndvi": {
      "question": "Como o NDVI de cada talhão evoluiu entre a primeira e a última imagem disponível?",
      "service": "MongoDB",
      "collection": "imagens",
      "pipeline": [
        {
          "$match": {
            "ndvi_medio": {
              "$type": "number"
            },
            "data": {
              "$type": "date"
            }
          }
        },
        {
          "$sort": {
            "talhao": 1,
            "data": 1
          }
        },
        {
          "$group": {
            "_id": "$talhao",
            "leituras": {
              "$sum": 1
            },
            "primeira_data": {
              "$first": "$data"
            },
            "primeiro_ndvi": {
              "$first": "$ndvi_medio"
            },
            "ultima_data": {
              "$last": "$data"
            },
            "ultimo_ndvi": {
              "$last": "$ndvi_medio"
            },
            "media_ndvi": {
              "$avg": "$ndvi_medio"
            }
          }
        },
        {
          "$project": {
            "_id": 0,
            "talhao": "$_id",
            "leituras": 1,
            "primeira_data": 1,
            "primeiro_ndvi": 1,
            "ultima_data": 1,
            "ultimo_ndvi": 1,
            "media_ndvi": {
              "$round": [
                "$media_ndvi",
                3
              ]
            },
            "variacao": {
              "$round": [
                {
                  "$subtract": [
                    "$ultimo_ndvi",
                    "$primeiro_ndvi"
                  ]
                },
                3
              ]
            }
          }
        },
        {
          "$sort": {
            "talhao": 1
          }
        }
